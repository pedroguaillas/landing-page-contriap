---
const modules = [
  {
    title: 'Facturación Electrónica',
    desc: 'Emite facturas, notas de crédito, retenciones y liquidaciones con autorización SRI automática.',
    color: 'blue',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    title: 'Gestión de Ventas',
    desc: 'Pedidos, clientes, cobranzas y análisis de ventas con gráficos diarios y comparativos en tiempo real.',
    color: 'green',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
  {
    title: 'Compras y Proveedores',
    desc: 'Gestiona compras, cuentas por pagar, proveedores y el flujo de pagos de tu empresa.',
    color: 'purple',
    icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'Inventario Multi-bodega',
    desc: 'Stock por variantes y SKU, transferencias entre bodegas, kardex completo y control de costos.',
    color: 'amber',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    title: 'Caja y Bancos',
    desc: 'Control de efectivo, cuentas bancarias, conciliación bancaria y flujo de caja integrado.',
    color: 'emerald',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Contabilidad General',
    desc: 'Plan de cuentas, asientos contables, centros de costos, activos fijos e intangibles con depreciación.',
    color: 'indigo',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: 'Recursos Humanos',
    desc: 'Empleados, roles de pago, nómina, décimos, IESS, anticipos y control de horas trabajadas.',
    color: 'rose',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Catálogo de Productos',
    desc: 'Variantes, atributos, precios por nivel, marcas, categorías, unidades de medida y márgenes de ganancia.',
    color: 'orange',
    icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z',
  },
];

const colorMap: Record<string, string> = {
  blue:    'bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400',
  green:   'bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400',
  purple:  'bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400',
  amber:   'bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400',
  emerald: 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400',
  indigo:  'bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400',
  rose:    'bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400',
  orange:  'bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400',
};
---

<section id="modulos" class="py-20 sm:py-28 bg-white dark:bg-navy-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">Módulos del Sistema</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 dark:text-white mb-4">
        Todo lo que tu empresa necesita
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed">
        Un ecosistema completo de gestión empresarial. Cada módulo trabaja integrado con los demás para darte control total.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {modules.map(({ title, desc, color, icon }) => (
        <div class="group bg-slate-50 dark:bg-navy-900 rounded-2xl p-6 border border-slate-100 dark:border-navy-800 hover:border-blue-200 dark:hover:border-blue-700 hover:shadow-lg hover:shadow-blue-100/50 dark:hover:shadow-navy-950/50 transition-all duration-200 hover:-translate-y-0.5">
          <div class={`w-11 h-11 rounded-xl ${colorMap[color]} flex items-center justify-center mb-4 transition-transform duration-200 group-hover:scale-110`}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={icon}/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-navy-900 dark:text-white mb-2">{title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
