    icon: 'M3 10h18M4 6h16a1 1 0 011 1v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a1 1 0 011-1zM7 15h4',
  },
  {
    title: 'Ventas y Cobranza',
