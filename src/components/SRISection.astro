---
const docTypes = [
    "Factura Electrónica",
    "Nota de Crédito",
    "Nota de Débito",
    "Retenciones",
    "Liquidación de Compra",
    "Guía de Remisión",
];
---

<section id="sri" class="py-20 sm:py-28 bg-white dark:bg-navy-950 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
            <!-- Left: content -->
            <div class="space-y-6">
                <div
                    class="inline-flex items-center gap-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-sm font-semibold px-4 py-1.5 rounded-full border border-green-200 dark:border-green-700/50"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                        ></path>
                    </svg>
                    100% Cumplimiento SRI Ecuador
                </div>

                <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 dark:text-white leading-tight">
                    Cumplimiento total<br />con el <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-400"
                        >SRI garantizado</span
                    >
                </h2>

                <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
                    ContriAP genera, firma, envía y autoriza todos los comprobantes electrónicos exigidos por el
                    Servicio de Rentas Internas del Ecuador. Autorización en tiempo real, sin trámites manuales.
                </p>

                <ul class="space-y-3">
                    {
                        [
                            "Firmado, envío y autorización en tiempo real al SRI",
                            "Generación de RIDE (representación impresa)",
                            "Envío automático por correo al cliente",
                            "Archivo XML firmado disponible siempre",
                            "Manejo de IVA, ICE y tarifas vigentes",
                        ].map((item) => (
                            <li class="flex items-start gap-3">
                                <div class="w-5 h-5 rounded-full bg-green-100 dark:bg-green-900/40 flex items-center justify-center shrink-0 mt-0.5">
                                    <svg
                                        class="w-3 h-3 text-green-600 dark:text-green-400"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="3"
                                        viewBox="0 0 24 24"
                                    >
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <span class="text-slate-700 dark:text-slate-300 text-sm font-medium">{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Right: document type cards -->
            <div class="relative">
                <div
                    class="absolute -inset-4 bg-gradient-to-br from-blue-50 to-slate-50 dark:from-navy-900 dark:to-navy-800 rounded-3xl -z-10"
                >
                </div>
                <div class="p-6 sm:p-8 space-y-4">
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-5">
                        Comprobantes soportados
                    </p>
                    <div class="grid grid-cols-2 gap-3">
                        {
                            docTypes.map((doc) => (
                                <div class="flex items-center gap-2.5 bg-white dark:bg-navy-800 rounded-xl px-4 py-3 border border-slate-100 dark:border-navy-700 shadow-sm">
                                    <div class="w-2 h-2 bg-green-500 rounded-full shrink-0" />
                                    <span class="text-xs font-semibold text-navy-800 dark:text-slate-200">{doc}</span>
                                </div>
                            ))
                        }
                    </div>

                    <!-- SRI Badge -->
                    <div
                        class="mt-6 bg-gradient-to-br from-navy-800 to-navy-900 dark:from-navy-700 dark:to-navy-800 rounded-2xl p-5 text-white flex items-center gap-4"
                    >
                        <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center shrink-0">
                            <svg
                                class="w-6 h-6 text-green-400"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-bold">Autorización automática</p>
                            <p class="text-xs text-slate-400 mt-0.5">
                                Tus facturas se autorizan en el SRI en segundos, sin intervención manual.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
