---
const steps = [
  {
    num: '01',
    title: 'Solicita tus credenciales',
    desc: 'Contáctanos por WhatsApp y en minutos te enviamos acceso personalizado al sistema, sin formularios ni esperas.',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  },
  {
    num: '02',
    title: 'Configura tu empresa',
    desc: 'Ingresa tus datos fiscales, sube tu logo, añade usuarios y define los parámetros del sistema según tu giro de negocio.',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    num: '03',
    title: 'Empieza a operar',
    desc: 'Emite tu primera factura electrónica SRI, gestiona tus ventas, controla tu inventario y mucho más — desde el primer día.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
];
---

<section id="como-funciona" class="py-20 sm:py-28 bg-slate-50 dark:bg-navy-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">Proceso</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 dark:text-white mb-4">
        Listo en 3 pasos simples
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-lg">
        Sin instalaciones, sin servidores, sin complicaciones. ContriAP funciona desde el navegador.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden lg:block absolute top-16 left-1/6 right-1/6 h-0.5 bg-gradient-to-r from-blue-200 via-blue-400 to-blue-200 dark:from-navy-700 dark:via-blue-600 dark:to-navy-700"></div>

      <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
        {steps.map(({ num, title, desc, icon }, i) => (
          <div class="relative flex flex-col items-center text-center">
            <!-- Number circle -->
            <div class="relative w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center mb-6 shadow-xl shadow-blue-600/30 z-10">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon}/>
              </svg>
              <div class="absolute -top-2 -right-2 w-6 h-6 bg-gold-400 rounded-full flex items-center justify-center">
                <span class="text-xs font-extrabold text-navy-900">{i + 1}</span>
              </div>
            </div>
            <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-3">{title}</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed max-w-xs">{desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA inline -->
    <div class="text-center mt-14">
      <a href="https://wa.me/593959649714?text=Hola%2C%20me%20interesa%20una%20demo%20de%20ContriAP%20%F0%9F%91%8B" target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-4 rounded-xl transition-all hover:shadow-xl hover:shadow-blue-600/30 hover:-translate-y-0.5 text-lg">
        Solicitar Demo por WhatsApp
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>

  </div>
</section>
