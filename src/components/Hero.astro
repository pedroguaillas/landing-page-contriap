---

---

<section
    class="relative min-h-screen flex items-center pt-16 overflow-hidden bg-gradient-to-br from-blue-50 via-white to-slate-50 dark:from-navy-950 dark:via-navy-900 dark:to-navy-950"
>
    <!-- Grid pattern background -->
    <div
        class="absolute inset-0 opacity-[0.04] dark:opacity-[0.06]"
        style="background-image: radial-gradient(circle, #1d39a0 1px, transparent 1px); background-size: 28px 28px;"
    >
    </div>

    <!-- Glow blobs -->
    <div
        class="absolute top-1/4 left-1/6 w-[500px] h-[500px] bg-blue-500 rounded-full filter blur-3xl opacity-[0.08] dark:opacity-[0.15] pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-1/4 right-1/6 w-[400px] h-[400px] bg-gold-400 rounded-full filter blur-3xl opacity-[0.05] dark:opacity-[0.08] pointer-events-none"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
        <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
            <!-- Left: copy -->
            <div class="space-y-7">
                <!-- Badge -->
                <div
                    class="inline-flex items-center gap-2 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-semibold px-4 py-1.5 rounded-full border border-blue-200 dark:border-blue-700/50"
                >
                    <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
                    Sistema ERP · Hecho para Ecuador
                </div>

                <!-- Headline -->
                <h1
                    class="text-4xl sm:text-5xl xl:text-6xl font-extrabold text-navy-900 dark:text-white leading-[1.1] tracking-tight"
                >
                    Factura, gestiona<br />y <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-400">crece con</span
                    ><br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-navy-700 to-blue-600 dark:from-blue-300 dark:to-blue-100"
                        >ContriAP</span
                    >
                </h1>

                <!-- Sub -->
                <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-lg">
                    Facturación electrónica SRI, contabilidad, ventas, compras, inventario y recursos humanos — todo
                    integrado en un sistema en la nube, moderno y fácil de usar.
                </p>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <a
                        href="https://wa.me/593959649714?text=Hola%2C%20me%20interesa%20contratar%20ContriAP%20%F0%9F%91%8B"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-4 rounded-xl transition-all duration-200 hover:shadow-2xl hover:shadow-blue-600/30 hover:-translate-y-0.5 text-base sm:text-lg"
                    >
                        Contratar
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                    <a
                        href="#modulos"
                        class="inline-flex items-center justify-center gap-2 border-2 border-slate-200 dark:border-navy-700 text-navy-900 dark:text-white font-semibold px-8 py-4 rounded-xl transition-all duration-200 hover:border-blue-400 dark:hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 text-base sm:text-lg"
                    >
                        Ver módulos
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </a>
                </div>

                <!-- Trust items -->
                <div class="flex flex-wrap gap-x-5 gap-y-2 pt-1">
                    {
                        ["✓ SRI Ecuador", "✓ 100% en la nube", "✓ Soporte en español", "✓ Sin instalación"].map(
                            (item) => (
                                <span class="text-sm text-slate-500 dark:text-slate-400 font-medium">{item}</span>
                            ),
                        )
                    }
                </div>
            </div>

            <!-- Right: dashboard mockup -->
            <div class="relative mt-8 lg:mt-0">
                <!-- Floating badge top-right -->
                <div
                    class="absolute -top-4 -right-2 sm:right-0 z-10 bg-green-500 text-white text-xs font-bold px-3 py-2 rounded-xl shadow-xl flex items-center gap-1.5"
                >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    SRI Autorizado
                </div>

                <!-- Browser frame -->
                <div
                    class="bg-white dark:bg-navy-800 rounded-2xl shadow-2xl shadow-navy-900/20 dark:shadow-black/60 border border-slate-200 dark:border-navy-700 overflow-hidden"
                >
                    <!-- Chrome bar -->
                    <div
                        class="flex items-center gap-2 px-4 py-3 bg-slate-100 dark:bg-navy-900 border-b border-slate-200 dark:border-navy-700"
                    >
                        <div class="flex gap-1.5">
                            <div class="w-3 h-3 bg-red-400 rounded-full"></div>
                            <div class="w-3 h-3 bg-yellow-400 rounded-full"></div>
                            <div class="w-3 h-3 bg-green-400 rounded-full"></div>
                        </div>
                        <div
                            class="flex-1 mx-3 bg-white dark:bg-navy-800 rounded-md px-3 py-1 text-xs text-slate-400 border border-slate-200 dark:border-navy-600 flex items-center gap-1.5"
                        >
                            <svg class="w-3 h-3 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    fill-rule="evenodd"
                                    d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            app.contriap.com
                        </div>
                    </div>

                    <!-- App content -->
                    <div
                        class="p-4 sm:p-5 space-y-4 bg-slate-50 dark:bg-navy-850"
                        style="background-color: var(--tw-bg, inherit);"
                    >
                        <!-- Top bar -->
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs text-slate-400 dark:text-slate-500">Empresa ABC Cía. Ltda.</p>
                                <h3 class="text-sm font-bold text-navy-900 dark:text-white">Panel Principal</h3>
                            </div>
                            <button
                                class="bg-blue-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1"
                            >
                                <svg
                                    class="w-3 h-3"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    viewBox="0 0 24 24"
                                >
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                                </svg>
                                Nueva Factura
                            </button>
                        </div>

                        <!-- KPI cards -->
                        <div class="grid grid-cols-3 gap-2 sm:gap-3">
                            <div
                                class="bg-white dark:bg-navy-700 rounded-xl p-3 border border-slate-100 dark:border-navy-600"
                            >
                                <p class="text-xs text-slate-400 dark:text-slate-400">Ventas hoy</p>
                                <p class="text-sm font-bold text-navy-900 dark:text-white mt-0.5">$3,240</p>
                                <p class="text-xs text-green-500 font-semibold">↑ 12%</p>
                            </div>
                            <div
                                class="bg-white dark:bg-navy-700 rounded-xl p-3 border border-slate-100 dark:border-navy-600"
                            >
                                <p class="text-xs text-slate-400 dark:text-slate-400">Facturas</p>
                                <p class="text-sm font-bold text-navy-900 dark:text-white mt-0.5">47</p>
                                <p class="text-xs text-blue-500 font-semibold">Hoy</p>
                            </div>
                            <div
                                class="bg-white dark:bg-navy-700 rounded-xl p-3 border border-slate-100 dark:border-navy-600"
                            >
                                <p class="text-xs text-slate-400 dark:text-slate-400">Por cobrar</p>
                                <p class="text-sm font-bold text-navy-900 dark:text-white mt-0.5">$8,120</p>
                                <p class="text-xs text-amber-500 font-semibold">3 pendientes</p>
                            </div>
                        </div>

                        <!-- Mini chart -->
                        <div
                            class="bg-white dark:bg-navy-700 rounded-xl p-3 sm:p-4 border border-slate-100 dark:border-navy-600"
                        >
                            <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 mb-3">
                                Ventas — últimos 7 días
                            </p>
                            <div class="flex items-end gap-1.5 h-16">
                                <div class="flex-1 rounded-t-sm bg-blue-200 dark:bg-blue-900/60" style="height: 42%">
                                </div>
                                <div class="flex-1 rounded-t-sm bg-blue-200 dark:bg-blue-900/60" style="height: 65%">
                                </div>
                                <div class="flex-1 rounded-t-sm bg-blue-200 dark:bg-blue-900/60" style="height: 50%">
                                </div>
                                <div class="flex-1 rounded-t-sm bg-blue-200 dark:bg-blue-900/60" style="height: 78%">
                                </div>
                                <div class="flex-1 rounded-t-sm bg-blue-200 dark:bg-blue-900/60" style="height: 60%">
                                </div>
                                <div class="flex-1 rounded-t-sm bg-blue-200 dark:bg-blue-900/60" style="height: 88%">
                                </div>
                                <div class="flex-1 rounded-t-sm bg-blue-600 dark:bg-blue-500" style="height: 100%">
                                </div>
                            </div>
                            <div class="flex justify-between mt-1.5">
                                {
                                    ["L", "M", "X", "J", "V", "S", "D"].map((d) => (
                                        <span class="flex-1 text-center text-xs text-slate-400 dark:text-slate-500">
                                            {d}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>

                        <!-- Recent invoices -->
                        <div
                            class="bg-white dark:bg-navy-700 rounded-xl border border-slate-100 dark:border-navy-600 overflow-hidden"
                        >
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-navy-600">
                                <p class="text-xs font-semibold text-slate-600 dark:text-slate-300">Últimas facturas</p>
                            </div>
                            <div class="divide-y divide-slate-50 dark:divide-navy-600">
                                <div class="flex items-center justify-between px-3 py-2">
                                    <div>
                                        <p class="text-xs font-semibold text-navy-800 dark:text-white">F-001-002847</p>
                                        <p class="text-xs text-slate-400">Distribuidora XYZ</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-xs font-bold text-navy-900 dark:text-white">$830.50</p>
                                        <span class="text-xs text-green-500 font-semibold">Autorizada</span>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between px-3 py-2">
                                    <div>
                                        <p class="text-xs font-semibold text-navy-800 dark:text-white">F-001-002846</p>
                                        <p class="text-xs text-slate-400">Empresa ABC S.A.</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-xs font-bold text-navy-900 dark:text-white">$245.00</p>
                                        <span class="text-xs text-green-500 font-semibold">Autorizada</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Floating bottom badge -->
                <div
                    class="absolute -bottom-4 -left-2 sm:left-0 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2.5 z-10"
                >
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse shrink-0"></div>
                    <span class="text-xs font-semibold text-navy-900 dark:text-white">Conectado al SRI</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce">
        <svg
            class="w-6 h-6 text-slate-300 dark:text-navy-600"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
        >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
    </div>
</section>
